<?xml version="1.0"?>
<!-- Small mobile manipulator for Gazebo Harmonic. The visual shell is illustrative. -->
<robot name="haetae_reference" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="meshes_dir" default="/workspace/ros/gazebo/meshes"/>

  <material name="graphite"><color rgba="0.10 0.16 0.21 1"/></material>
  <material name="shell_white"><color rgba="0.88 0.94 0.95 1"/></material>
  <material name="sensor_glass"><color rgba="0.035 0.09 0.13 1"/></material>
  <material name="sensor_teal"><color rgba="0.13 0.75 0.78 1"/></material>
  <material name="arm_silver"><color rgba="0.61 0.72 0.76 1"/></material>

  <link name="chassis">
    <visual name="authored_shell"><geometry><mesh filename="file://$(arg meshes_dir)/chassis.dae"/></geometry></visual>
    <collision><origin xyz="0 0 0.20"/><geometry><box size="0.40 0.30 0.20"/></geometry></collision>
    <inertial><origin xyz="0 0 0.20"/><mass value="4"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/></inertial>
  </link>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
    <visual name="authored_shell"><geometry><mesh filename="file://$(arg meshes_dir)/wheel.dae"/></geometry></visual>
      <collision><geometry><cylinder radius="0.10" length="0.04"/></geometry></collision>
      <inertial><mass value="0.25"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="chassis"/><child link="${side}_wheel"/>
      <origin xyz="0 ${y} 0.10" rpy="-1.57079632679 0 0"/><axis xyz="0 0 1"/>
      <dynamics damping="0.1"/>
    </joint>
  </xacro:macro>
  <xacro:wheel side="left" y="0.18"/>
  <xacro:wheel side="right" y="-0.18"/>

  <link name="caster">
    <visual><geometry><sphere radius="0.05"/></geometry><material name="graphite"/></visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="chassis"/><child link="caster"/><origin xyz="-0.17 0 0.05"/>
  </joint>

  <link name="arm">
    <visual name="authored_shell"><geometry><mesh filename="file://$(arg meshes_dir)/arm.dae"/></geometry></visual>
    <collision><origin xyz="0.15 0 0"/><geometry><box size="0.30 0.04 0.04"/></geometry></collision>
    <inertial><origin xyz="0.15 0 0"/><mass value="0.2"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="chassis"/><child link="arm"/><origin xyz="0 0 0.36"/>
    <axis xyz="0 0 1"/><limit lower="-1" upper="1" effort="5" velocity="2"/>
    <dynamics damping="0.1"/>
  </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="shoulder">
      <command_interface name="position"><param name="min">-1</param><param name="max">1</param></command_interface>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>
