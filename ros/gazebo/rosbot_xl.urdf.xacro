<?xml version="1.0"?>
<!-- Haetae simulation adapter. Geometry, inertia, axes and physical limits
     come from the pinned manufacturer macros; see vendor/README.md. -->
<robot name="rosbot_xl" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="vendor_dir" default="/workspace/ros/gazebo/vendor"/>
  <xacro:arg name="controllers_file" default="/workspace/ros/gazebo/controllers.yaml"/>
  <xacro:include filename="$(arg vendor_dir)/rosbot_ros/rosbot_description/urdf/rosbot_xl/body.urdf.xacro" ns="body"/>
  <xacro:include filename="$(arg vendor_dir)/rosbot_ros/rosbot_description/urdf/rosbot_xl/wheel.urdf.xacro" ns="wheel"/>
  <xacro:include filename="$(arg vendor_dir)/rosbot_ros/rosbot_description/urdf/rosbot_xl/components/antenna.urdf.xacro" ns="antenna"/>
  <xacro:include filename="$(arg vendor_dir)/rosbot_ros/rosbot_description/urdf/open_manipulator/body.xacro" ns="arm"/>
  <xacro:body.body wheel_radius="0.048"/>
  <xacro:antenna.antenna parent_link="cover_link" xyz="-0.155 -0.055 -0.02" rpy="-0.4 0 0" antenna_angle="0.3"/>
  <xacro:wheel.wheel wheel_radius="0.048" side="fl" mecanum="False"/>
  <xacro:wheel.wheel wheel_radius="0.048" side="fr" mecanum="False"/>
  <xacro:wheel.wheel wheel_radius="0.048" side="rl" mecanum="False"/>
  <xacro:wheel.wheel wheel_radius="0.048" side="rr" mecanum="False"/>
  <!-- The manufacturer's XL manipulation mounting pose. -->
  <xacro:arm.open_manipulator_x parent_link="cover_link" xyz="-0.11 0 0"/>

  <ros2_control name="HaetaeRosbotXL" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:macro name="drive_interface" params="name">
      <joint name="${name}">
        <command_interface name="velocity"/>
        <state_interface name="position"/><state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:drive_interface name="fl_wheel_joint"/><xacro:drive_interface name="fr_wheel_joint"/>
    <xacro:drive_interface name="rl_wheel_joint"/><xacro:drive_interface name="rr_wheel_joint"/>
    <xacro:macro name="arm_interface" params="name lower upper initial">
      <joint name="${name}">
        <command_interface name="position"><param name="min">${lower}</param><param name="max">${upper}</param></command_interface>
        <state_interface name="position"><param name="initial_value">${initial}</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <!-- Manufacturer Home pose, with the gripper held closed. -->
    <xacro:arm_interface name="joint1" lower="${-4/5*pi}" upper="${pi}" initial="0"/>
    <xacro:arm_interface name="joint2" lower="${-pi/2}" upper="${pi/2}" initial="-1"/>
    <xacro:arm_interface name="joint3" lower="-1.5" upper="1.4" initial="0.7"/>
    <xacro:arm_interface name="joint4" lower="-1.7" upper="1.97" initial="0.3"/>
    <xacro:arm_interface name="gripper_left_joint" lower="-0.010" upper="0.019" initial="-0.009"/>
    <joint name="gripper_right_joint">
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <!-- Simulator servo tuning; keep the gate's 0.05 rad tracking limit. -->
      <position_proportional_gain>0.5</position_proportional_gain>
    </plugin>
  </gazebo>
</robot>
