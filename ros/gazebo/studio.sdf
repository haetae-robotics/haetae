<?xml version="1.0"?>
<!-- The reference physics plane and systems are unchanged; bay marks are visual only. -->
<sdf version="1.6">
  <world name="empty">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <scene><ambient>0.35 0.36 0.38 1</ambient><background>0.85 0.86 0.88 1</background><shadows>true</shadows></scene>
    <light type="directional" name="studio_key">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.86 0.88 0.90 1</diffuse><specular>0.25 0.25 0.25 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.3 -0.9</direction>
    </light>
    <light type="directional" name="studio_fill">
      <cast_shadows>false</cast_shadows><pose>0 0 8 0 0 0</pose>
      <diffuse>0.24 0.28 0.33 1</diffuse><specular>0.1 0.1 0.1 1</specular><direction>0.6 -0.4 -0.7</direction>
    </light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        <material><ambient>0.80 0.82 0.84 1</ambient><diffuse>0.80 0.82 0.84 1</diffuse><specular>0.06 0.06 0.06 1</specular></material>
      </visual>
    </link></model>
    <model name="calibration_bay"><static>true</static><pose>5.35 5 0.002 0 0 0</pose><link name="marks">
      <visual name="back"><pose>0 0.85 0 0 0 0</pose><geometry><box><size>1.7 0.009 0.001</size></box></geometry><material><ambient>0.52 0.57 0.61 1</ambient><diffuse>0.52 0.57 0.61 1</diffuse></material></visual>
      <visual name="front"><pose>0 -0.85 0 0 0 0</pose><geometry><box><size>1.7 0.009 0.001</size></box></geometry><material><ambient>0.52 0.57 0.61 1</ambient><diffuse>0.52 0.57 0.61 1</diffuse></material></visual>
      <visual name="left"><pose>-0.85 0 0 0 0 0</pose><geometry><box><size>0.009 1.7 0.001</size></box></geometry><material><ambient>0.52 0.57 0.61 1</ambient><diffuse>0.52 0.57 0.61 1</diffuse></material></visual>
      <visual name="right"><pose>0.85 0 0 0 0 0</pose><geometry><box><size>0.009 1.7 0.001</size></box></geometry><material><ambient>0.52 0.57 0.61 1</ambient><diffuse>0.52 0.57 0.61 1</diffuse></material></visual>
      <visual name="center_tick"><pose>-0.35 0 0.001 0 0 0</pose><geometry><box><size>0.012 0.08 0.001</size></box></geometry><material><ambient>0.34 0.45 0.49 1</ambient><diffuse>0.34 0.45 0.49 1</diffuse></material></visual>
    </link></model>
